# Custom matplotlib style for scientific plots with LaTeX

# Use LaTeX for text rendering
text.usetex : True
# Preamble also declares raw-Unicode fallbacks (DeclareUnicodeCharacter) so that
# labels/titles typed with literal Greek letters, arrows, etc. render instead of
# raising a LaTeX compile error — avoids having to escape every plot string by hand.
text.latex.preamble : \usepackage{amsmath} \usepackage{amssymb} \DeclareUnicodeCharacter{2192}{\ensuremath{\rightarrow}} \DeclareUnicodeCharacter{2190}{\ensuremath{\leftarrow}} \DeclareUnicodeCharacter{2713}{\ensuremath{\checkmark}} \DeclareUnicodeCharacter{00B7}{\ensuremath{\cdot}} \DeclareUnicodeCharacter{2500}{\textemdash} \DeclareUnicodeCharacter{2014}{\textemdash} \DeclareUnicodeCharacter{2550}{\textemdash} \DeclareUnicodeCharacter{00B1}{\ensuremath{\pm}} \DeclareUnicodeCharacter{25CB}{\ensuremath{\circ}} \DeclareUnicodeCharacter{25A1}{\ensuremath{\square}} \DeclareUnicodeCharacter{25C7}{\ensuremath{\Diamond}} \DeclareUnicodeCharacter{2248}{\ensuremath{\approx}} \DeclareUnicodeCharacter{03C3}{\ensuremath{\sigma}} \DeclareUnicodeCharacter{2211}{\ensuremath{\sum}} \DeclareUnicodeCharacter{00B2}{\ensuremath{^2}} \DeclareUnicodeCharacter{2212}{\ensuremath{-}} \DeclareUnicodeCharacter{222B}{\ensuremath{\int}} \DeclareUnicodeCharacter{03A3}{\ensuremath{\Sigma}} \DeclareUnicodeCharacter{03C4}{\ensuremath{\tau}} \DeclareUnicodeCharacter{2026}{\ldots} \DeclareUnicodeCharacter{0394}{\ensuremath{\Delta}}

# Font sizes — all at 18 pt; change here to rescale everything at once
font.size             : 18
axes.labelsize        : 18
axes.titlesize        : 18
xtick.labelsize       : 18
ytick.labelsize       : 18
legend.fontsize       : 13
legend.title_fontsize : 13

# Font family
font.family : serif
font.serif : Computer Modern Roman

# Figure size (override per-notebook: set FIG_W/FIG_H then plt.rcParams['figure.figsize'] = [FIG_W, FIG_H])
figure.figsize : 10, 6
figure.dpi : 150

# Line widths
lines.linewidth : 2.5
axes.linewidth : 1.5
grid.linewidth : 1.0

# Marker sizes
lines.markersize : 10

# Grid
axes.grid : False
grid.alpha : 0.3
grid.linestyle : --

# Legend
legend.frameon      : False
legend.borderaxespad: 0.2

# Axes
axes.labelpad : 2
axes.titlepad : 12

# NPG (Nature Publishing Group) color palette — colorblind-friendly, print-safe
# C0=Blue/Cyan  C1=Red  C2=Teal  C3=Navy  C4=Coral  C5=Lavender  C6=Light Teal  C7=Bright Red  C8=Brown  C9=Gray
axes.prop_cycle : cycler(color=['4DBBD5', 'E64B35', '00A087', '3C5488', 'F39B7F', '8491B4', '91D1C2', 'DC0000', '7E6148', '949494'])

# Tick parameters
xtick.major.size : 6
xtick.major.width : 1.5
ytick.major.size : 6
ytick.major.width : 1.5

# Save figure settings
savefig.dpi : 300
savefig.bbox : tight
savefig.pad_inches : 0.1
savefig.format : pdf
